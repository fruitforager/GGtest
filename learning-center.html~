  <style>
    /* =====================================================
       1. SYSTEM VARIABLES & DESIGN TOKENS
    ===================================================== */
    :root {
      --bg: #FAF0E6;
      --text: #1a1a18;
      --green: #274D31;
      --green-dark: #21452c;
      --blue: #2f5d8f;
      --blue-dark: #21425c;
      --border: #d8ccb6;
      --sidebar-width: 14rem;
      --max-container: 1380px;

      /* Brand Typography Palette */
      --color-forest:    #1e3d28;
      --color-leaf:      #2d5e3a;
      --color-sage:      #5a7d5f;
      --color-mist:      #e8f0e9;
      --color-parchment: #faf6ef;
      --color-crimson:   #9b1c2e;
        --teal:#14323a;
      --color-gold:      #c8882a;
      --color-ink:       #1a1a18;
      --font-display: 'Playfair Display', serif;
      --font-body: 'DM Sans', sans-serif;
    }

    /* =====================================================
       2. GLOBAL RESET & TYPOGRAPHY SYSTEM
    ===================================================== */
    *, *::before, *::after { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      line-height: 1.6;
      font-size: 18px;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    
    .shadow-text { 
      font-family: var(--font-display); 
      font-size: clamp(2.75rem, 8vw, 4.5rem); 
      font-weight: 900; 
      line-height: 1.05; 
      color: var(--color-crimson); 
      margin-bottom: 0.25rem;
      text-shadow: 1px 2px 3px rgba(0,0,0,0.12);
    }

    .custom-main-title {
      font-family: var(--font-body);
      font-size: clamp(1.6rem, 3.5vw, 2.6rem);
      font-weight: 900;
      color: var(--blue);
      line-height: 1.25;
      margin: 40px 0 24px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08); 
      letter-spacing: -0.02em;
      max-width: 900px;
    }

    h2 { 
      color: var(--color-forest); 
      font-family: var(--font-display);
      font-weight: 900; 
      font-size: 1.85rem;
      margin-top: 48px;
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .category-intro {
      font-size: 1.1rem;
      color: var(--text);
      margin-bottom: 24px;
      max-width: 760px;
    }

    p { 
      margin: 0 0 16px; 
      font-size: 1.05rem; 
      color: var(--text); 
    }

    /* =====================================================
       3. SITE STRUCTURE & GRID ARCHITECTURE
    ===================================================== */
    .page-wrapper {
      max-width: var(--max-container); 
      margin: 0 auto;
      display: flex; 
      flex-direction: column; 
      min-height: 100vh;
    }
    @media (min-width: 768px) { 
      .page-wrapper { flex-direction: row; } 
    }

    .main-wrapper { 
      flex: 1; 
      min-width: 0; 
      padding: 2rem 1.25rem; 
    }
    @media (min-width: 768px) { 
      .main-wrapper { padding: 2.5rem 2.5rem 2.5rem 4rem; } 
    }
    @media (min-width: 1024px) { 
      .main-wrapper { padding: 2.5rem 4rem 2.5rem 5rem; } 
    }

    main { 
      max-width: 64rem; 
      margin: 0 auto; 
    }

    /* CSS Grid Layout for Resource Cards */
    .resource-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 40px;
    }
    @media (min-width: 640px) {
      .resource-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* =====================================================
       4. HIGH DESIGN GLOSS RESOURCE CARDS (.button-neutral style)
    ===================================================== */
    .resource-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.75rem;
      border-radius: 16px;
      text-decoration: none;
      color: var(--text);
      
      /* Exact translation of .button-neutral 3D Gloss Tokens */
      background: linear-gradient(to bottom, 
        rgba(255, 255, 255, 0.98) 0%, 
        rgba(255, 255, 255, 0.65) 40%, 
        rgba(245, 242, 235, 0.50) 100
      );
      background-color: rgba(255, 255, 255, 0.5); 
      background-clip: padding-box; 
      border: 1px solid rgba(90, 125, 95, 0.35); 
      
      box-shadow: 
        inset 0 1.5px 1px rgba(255, 255, 255, 0.95), 
        inset 0 -1px 2px rgba(0, 0, 0, 0.03),
        0 1px 2px rgba(0, 0, 0, 0.06), 
        0 4px 12px rgba(0, 0, 0, 0.04);
        
      transition: transform 0.25s cubic-bezier(.2,.9,.25,1), filter 0.25s ease, box-shadow 0.25s ease;
    }

    .resource-card:hover {
      background-color: rgba(255, 255, 255, 0.80);
      transform: translateY(-4px);
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.04)) drop-shadow(0 10px 20px rgba(45, 94, 58, 0.08));
      border-color: rgba(90, 125, 95, 0.6);
    }

    .card-body h3 {
      font-family: var(--font-body);
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--color-forest);
      margin-bottom: 8px;
      line-height: 1.3;
    }

    .card-body p {
      font-size: 0.95rem;
      line-height: 1.5;
      color: #333;
      margin-bottom: 16px;
    }

    .card-link-label {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--blue);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: auto;
    }
    
    .card-link-label .arrow {
      transition: transform 0.2s ease;
    }
    
    .resource-card:hover .card-link-label .arrow {
      transform: translateX(4px);
    }

    /* Decorative Tags */
    .anniversary-tag {
      display: inline-flex;
      font-size: 0.93rem;
      font-weight: 900;
      color: var(--green); 
      letter-spacing: 0.09em; 
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15); 
      margin-bottom: 2px;
    }

    .thin-rule {
      border: none;
      border-top: 1.4px solid rgba(0,0,0,0.15);
      margin: 0.3rem 0;
    }

    /* =====================================================
       5. ADAPTIVE SIDEBAR NAVIGATION SYSTEM
    ===================================================== */
    .sidebar {
      width: 100%; 
      background-color: var(--teal); 
      color: #fff;
      flex-shrink: 0; 
      z-index: 50;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
